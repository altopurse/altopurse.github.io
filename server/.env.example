# Copy to .env for local work. On Render these go in Environment instead —
# never commit real values, this repo is public.

# Mollie. test_ keys move no money; swap to live_ only on Render.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the browser is served from. Used for CORS and the post-payment
# redirect. Comma-separate to allow more than one.
SITE_ORIGIN=https://altopurse.github.io

# Public URL of this API. Mollie calls the webhook on it, so it must be
# reachable from the internet — use an ngrok tunnel when testing locally.
PUBLIC_API_URL=https://tumanic-api.onrender.com

# Firestore. Paste the whole service account JSON on a single line.
# Leave blank and the API serves the repo's data/*.json read-only, which is
# enough to test Mollie checkout before the database exists.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
FIRESTORE_PROJECT_ID=

# Spotify app from developer.spotify.com/dashboard. Leave blank to skip sync.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=5AhJwuhl8vQJB0rBqZ7UFI

# Buttondown, for the mailing list. Leave blank to disable signup.
BUTTONDOWN_API_KEY=

# Shared secret protecting POST /api/admin/sync. Make it long and random.
ADMIN_TOKEN=
